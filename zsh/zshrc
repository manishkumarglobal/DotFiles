
# Directory holding these zsh configs, resolved through the ~/.zshrc symlink.
ZSH_CONFIG_DIR=${${(%):-%x}:A:h}

# Private, persistent cache for the completion dump and generated completions.
ZSH_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $ZSH_CACHE/completions ]] || mkdir -p -m 700 $ZSH_CACHE $ZSH_CACHE/completions

# Enabling Antigen https://github.com/zsh-users/antigen
source ~/antigen.zsh

# Load the oh-my-zsh's library.
antigen use oh-my-zsh

# Bundles from the default repo (robbyrussell's oh-my-zsh).
# antigen bundle git
antigen bundles <<EOBUNDLES
  git
  colored-man-pages
  cp
  iterm2
  screen
  systemadmin
  torrent
  zsh-navigation-tools
  djui/alias-tips
  zsh-users/zsh-completions
  zsh-users/zsh-autosuggestions
  zsh-users/zsh-syntax-highlighting
  zsh-users/zsh-history-substring-search
EOBUNDLES
#  ssh-agent
#  chucknorris

antigen theme agnoster
#antigen theme history-substring-search
#antigen bundle zsh-autosuggestions
#antigen bundle vagrant
#antigen bundle nomad
#antigen bundle docker

# Python Plugins
#antigen bundle pip
#antigen bundle python
#antigen bundle virtualenv

# Load the theme.
# antigen theme robbyrussell

# Tell Antigen that you're done.
antigen apply

# Antigen also appends every bundle directory to PATH; plugins load through
# fpath and source, so drop them to keep stray plugin scripts (e.g. iterm2's
# `update`) from resolving as commands.
path=(${path:#$HOME/.antigen/bundles/*})

# Sourcing my custom ZSH variables (PATH first, so later tool checks see it)
source $ZSH_CONFIG_DIR/variables.zsh

# Sourcing Theme configs
#source $ZSH_CONFIG_DIR/custom_agnoster-theme.zsh

# Sourcing Autojump settings
source $ZSH_CONFIG_DIR/autojump.zsh

# Sourcing zstyle configs
source $ZSH_CONFIG_DIR/zstyles.zsh

# Auto completion configs (the only place compinit runs)
source $ZSH_CONFIG_DIR/completion.zsh

# Sourcing setopt configs
source $ZSH_CONFIG_DIR/setopt.zsh

# Sourcing ZSH mod configs
source $ZSH_CONFIG_DIR/modules.zsh

# Sourcing ZSH functions
#source $ZSH_CONFIG_DIR/functions.zsh

# Sourcing Key binding configs
source $ZSH_CONFIG_DIR/key_bindings.zsh

# Sourcing some extra zsh configs
source $ZSH_CONFIG_DIR/extra.zsh

# Sourcing installed plugins configs
source $ZSH_CONFIG_DIR/plugins_configs.zsh

# nvm is loaded without activating a version, so `node` stays Homebrew's until `nvm use`.
export NVM_DIR="$HOME/.nvm"
if [[ -s $NVM_DIR/nvm.sh ]]; then
  # Parsed without aliases, so oh-my-zsh's grep alias is not baked into nvm's functions.
  () { setopt localoptions noaliases; source "$NVM_DIR/nvm.sh" --no-use }
  # nvm's alias parsing uses `#` patterns that fail under extendedglob (setopt.zsh).
  functions -c nvm _nvm_unwrapped
  nvm() { setopt localoptions noextendedglob; _nvm_unwrapped "$@" }
fi

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

export PATH="$HOME/.local/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# AI Image generation
export HF_HOME="$HOME/Library/Caches/hf-image-gen"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_ASSETS_CACHE="$HF_HOME/assets"
export HF_TOKEN_PATH="$HF_HOME/token"

# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/Downloads/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/Downloads/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc"; fi

# Sourcing Aliases last, so they never expand inside third-party scripts sourced above
source $ZSH_CONFIG_DIR/aliases.zsh
